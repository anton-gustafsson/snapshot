{
  "name": "nav-snapshot-viewer",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n docs,gallery -c cyan,yellow \"npm run dev -w apps/docs\" \"npm run dev -w apps/gallery\"",
    "dev:docs": "npm run dev -w apps/docs",
    "dev:gallery": "npm run dev -w apps/gallery",
    "build:packages": "npm run build -w packages/core",
    "test": "npm run test -w packages/core",
    "test:e2e": "start-server-and-test dev:gallery http://localhost:3200 \"cypress run\"",
    "test:e2e:open": "start-server-and-test dev:gallery http://localhost:3200 \"cypress open\"",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "npm run typecheck -w packages/core && tsc -p cypress/tsconfig.json"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cypress": "^16.0.0",
    "start-server-and-test": "^3.0.12"
  }
}
